# Copy to .env.local and fill in from your own Firebase project (Project settings > Your apps > Web app).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# App Check. Production: a reCAPTCHA Enterprise site key. Local: a debug token registered in the console (or "true" to have one printed).
VITE_RECAPTCHA_ENTERPRISE_KEY=
VITE_APPCHECK_DEBUG_TOKEN=
